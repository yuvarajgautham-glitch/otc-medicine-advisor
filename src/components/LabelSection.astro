---
import { asBullets } from '../lib/format.mjs';

interface Props {
	title: string;
	text?: string;
	icon?: string;
	variant?: 'default' | 'danger' | 'warn';
}

const { title, text = '', icon, variant = 'default' } = Astro.props;

// Sections are omitted entirely when the label had nothing to say, rather than
// rendering an empty box or inventing filler.
const trimmed = (text ?? '').trim();
const bullets = asBullets(trimmed);
const cls = variant === 'default' ? 'section' : `section section--${variant}`;
---

{
	trimmed.length > 0 && (
		<section class={cls}>
			<h2>
				{icon && <span aria-hidden="true">{icon}</span>}
				{title}
			</h2>
			{bullets ? (
				<ul class="label-list">
					{bullets.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			) : (
				<p class="label-text">{trimmed}</p>
			)}
		</section>
	)
}
